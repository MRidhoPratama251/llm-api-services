# ==============================================================================
# CONTOH TEMPLATE VARIABEL LINGKUNGAN (.env.example)
# Salin file ini menjadi '.env' dan isi dengan kunci rahasia Anda sendiri.
# ==============================================================================
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# URL endpoint yang digunakan oleh client (ganti dengan URL ngrok Anda saat diakses dari luar)
# Contoh: https://your-subdomain.ngrok-free.app
CLIENT_TARGET_URL=http://127.0.0.1:8000

# API Key untuk verifikasi header X-API-Key
LLM_API_KEY=sk-local-ganti-dengan-key-acak-anda

# Fernet Shared Secret Key (Generate dari _notebook/api-key-generator.ipynb)
LLM_SECRET_KEY=ganti-dengan-kunci-fernet-base64-anda=

# JWT Secret Key (Generate dari _notebook/jwt-key-generator.ipynb)
JWT_SECRET_KEY=ganti-dengan-kunci-jwt-hex-anda
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Engine llama-server lokal
LLAMA_SERVER_BASE_URL=http://localhost:8080
MODEL_CONFIG_PATH=model_config.json
READY_TIMEOUT=30
